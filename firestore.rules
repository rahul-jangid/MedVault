rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Max document size guard (prevents field abuse)
    function hasReasonableFieldCount() {
      return request.resource.data.keys().size() < 20;
    }

    // Asset size guards (prevents cost abuse from large base64 images)
    function imageDataWithinLimit() {
      return !('imageData' in request.resource.data) || 
             request.resource.data.imageData.size() < 1500000;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasReasonableFieldCount();
      allow update: if isOwner(userId) && hasReasonableFieldCount();
      allow delete: if isOwner(userId);

      match /prescriptions/{prescriptionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        request.resource.data.userId == userId &&
                        hasReasonableFieldCount() &&
                        imageDataWithinLimit();
        allow update: if isOwner(userId) && 
                        hasReasonableFieldCount() &&
                        imageDataWithinLimit();
        allow delete: if isOwner(userId);
      }

      match /reports/{reportId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && 
                        request.resource.data.userId == userId &&
                        hasReasonableFieldCount() &&
                        imageDataWithinLimit();
        allow update: if isOwner(userId) && 
                        hasReasonableFieldCount() &&
                        imageDataWithinLimit();
        allow delete: if isOwner(userId);
      }
    }
  }
}
